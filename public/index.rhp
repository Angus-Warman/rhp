<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
</head>

<body>
    <p>
        This page has been visited
        <strong><rhp method="GET">
            const exec = await DB.Exec("CREATE TABLE IF NOT EXISTS visits (value INTEGER)");
            await exec.Run();
            const table = await DB.Table("visits");
            const count = await table.Count();
            if (count === 0) {
                await (await table.Insert({ value: 1 })).Run();
                write(1);
            } else {
                const row = await table.One();
                const visits = row.value + 1;
                await (await table.Update({ value: visits })).Run();
                write(visits);
            }
        </rhp></strong>
        times.
    </p>
</body>

</html>
