<!doctype html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chat</title>
    <meta name="color-scheme" content="dark light" />
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        #app {
            display: flex;
            flex-direction: column;
            height: 100vh;
            max-width: 720px;
            margin: 0 auto;
        }

        header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            padding: 12px 16px;
            border-bottom: 1px solid currentColor;
        }

        h1 {
            font-size: 18px;
            margin: 0;
        }

        #messages {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .message {
            max-width: 78%;
            padding: 8px 12px;
            border-radius: 14px;
            align-self: flex-start;
        }

        .message.self {
            align-self: flex-end;
        }

        .message.system {
            align-self: center;
            background: transparent;
            font-size: 12px;
        }

        .message .sender {
            display: block;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .message.system .sender {
            display: none;
        }

        #chat-form {
            display: flex;
            gap: 8px;
            padding: 12px 16px;
            border-top: 1px solid currentColor;
        }

        #name {
            width: 110px;
            border: 1px solid currentColor;
            border-radius: 8px;
            padding: 8px 10px;
            font-size: 14px;
        }

        #message {
            flex: 1;
            border-radius: 8px;
            padding: 8px 10px;
            font-size: 14px;
        }

        #chat-form button {
            border: none;
            border-radius: 8px;
            padding: 8px 18px;
            background: #1f6fb2;
            color: #fff;
            font-size: 14px;
            cursor: pointer;
        }

        #chat-form button:hover {
            background: #185a91;
        }
    </style>
</head>

<body>
    <div id="app">
        <header>
            <h1 id="title">Room: general</h1>
            <span id="status">connecting...</span>
        </header>
        <div id="messages"></div>
        <form id="chat-form">
            <input id="name" type="text" autocomplete="nickname" placeholder="Name" />
            <input id="message" type="text" autocomplete="off" placeholder="Type a message..." />
            <button type="submit">Send</button>
        </form>
    </div>

    <script>
        const params = new URLSearchParams(location.search);
        const room = params.get('room') || 'general';
        let name = 'anon';
        try {
            name = localStorage.getItem('chat.name') || params.get('name') || 'anon';
        } catch (e) { /* localStorage unavailable (file://, private mode) */ }
        let me = null;
        let ws = null;
        let attempts = 0;
        let retryTimer = null;

        const titleEl = document.getElementById('title');
        const statusEl = document.getElementById('status');
        const messagesEl = document.getElementById('messages');
        const form = document.getElementById('chat-form');
        const nameInput = document.getElementById('name');
        const messageInput = document.getElementById('message');

        titleEl.textContent = 'Room: ' + room;
        nameInput.value = name;

        function setStatus(text) {
            statusEl.textContent = text;
            statusEl.classList.toggle('ok', /connected/i.test(text));
        }

        function socketUrl() {
            const proto = location.protocol === 'https:' ? 'wss' : 'ws';
            return proto + '://' + location.host + location.pathname + location.search;
        }

        function addMessage(msg) {
            const row = document.createElement('div');
            row.className = 'message';
            if (msg.self) row.classList.add('self');
            if (msg.system) row.classList.add('system');

            const sender = document.createElement('span');
            sender.className = 'sender';
            sender.textContent = msg.system ? 'system' : (msg.name || 'anon');

            const text = document.createElement('span');
            text.className = 'text';
            text.textContent = msg.text;

            row.appendChild(sender);
            row.appendChild(text);
            messagesEl.appendChild(row);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        function connect() {
            clearTimeout(retryTimer);
            if (location.protocol === 'file:') {
                setStatus('open via the rhp server');
                console.error(
                    'chat.rhp was opened from the filesystem. Start the rhp server and visit http://localhost:<port>/chat.rhp'
                );
                return;
            }
            const url = socketUrl();
            setStatus(attempts ? 'reconnecting...' : 'connecting...');
            console.log('chat: connecting to', url);

            ws = new WebSocket(url);

            ws.addEventListener('open', () => {
                attempts = 0;
                setStatus('connected');
            });

            ws.addEventListener('message', (event) => {
                let data;
                try { data = JSON.parse(event.data); } catch (e) { return; }

                if (data.event === 'welcome') {
                    me = data.id;
                    setStatus('connected as ' + me.slice(0, 8));
                    if (data.history) {
                        data.history.forEach((row) => {
                            let m;
                            try { m = JSON.parse(row.body); } catch (e) { return; }
                            addMessage(m);
                        });
                    }
                } else if (data.event === 'leave') {
                    addMessage({ system: true, text: 'A user left the room' });
                } else {
                    addMessage(data);
                }
            });

            ws.addEventListener('error', () => {
                console.error('chat: websocket error on', url);
                setStatus('connection error');
            });

            ws.addEventListener('close', (event) => {
                console.warn('chat: websocket closed', { code: event.code, reason: event.reason, url });
                setStatus('disconnected');
                attempts += 1;
                const delay = Math.min(1000 * 2 ** (attempts - 1), 15000);
                retryTimer = setTimeout(connect, delay);
            });
        }

        form.addEventListener('submit', (event) => {
            event.preventDefault();
            const text = messageInput.value.trim();
            if (!text) return;
            if (!ws || ws.readyState !== WebSocket.OPEN) return;
            name = nameInput.value.trim() || 'anon';
            try { localStorage.setItem('chat.name', name); } catch (e) { }
            addMessage({ name: name, text: text, self: true });
            ws.send(JSON.stringify({ name: name, text: text }));
            messageInput.value = '';
            messageInput.focus();
        });

        connect();
    </script>
</body>

</html>

<rhp method="GET">
    try DB.Exec("CREATE TABLE IF NOT EXISTS messages (id INTEGER PRIMARY KEY, createdAt INTEGER, room TEXT, body TEXT)").Run()
</rhp>

<rhp method="SOCKET">
    let room = QUERY.room || "general"
    SOCKET.Join(room)

    let history = DB.Query("SELECT * FROM (SELECT * FROM messages WHERE room = ? ORDER BY id DESC LIMIT 10) ORDER BY id ASC").Bind(room).All()

    SOCKET.Client().OnMessage(msg => {
        DB.Table("messages").Insert({ room: room, body: msg }).Run()
        SOCKET.Peers().Send(msg)
    })
    SOCKET.Client().OnClose(() => SOCKET.Everyone().Send({ event: "leave", id: SOCKET.Client().Id() }))
    return { event: "welcome", id: SOCKET.Client().Id(), room: room, history: history }
</rhp>