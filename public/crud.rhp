<rhp method="GET">
try DB.Exec("CREATE TABLE IF NOT EXISTS widgets (id INTEGER PRIMARY KEY, name TEXT)").Run()

if (QUERY) {
  return DB.Table("widgets").Where({ id: QUERY.id }).All()
}
return DB.Table("widgets").All()
</rhp>

<rhp method="POST">
return DB.Table("widgets").Insert(BODY).Run()
</rhp>

<rhp method="PUT">
return DB.Table("widgets").Where({ id: QUERY.id }).Update(BODY).Run()
</rhp>

<rhp method="DELETE">
return DB.Table("widgets").Where({ id: QUERY.id }).Delete().Run()
</rhp>
