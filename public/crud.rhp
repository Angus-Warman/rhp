<rhp method="GET">
const exec = DB.Exec("CREATE TABLE IF NOT EXISTS widgets (id INTEGER PRIMARY KEY, name TEXT)");
await exec.Run();
const table = DB.Table("widgets");
if (QUERY.id) {
    writeRaw(JSON.stringify(await table.Where({ id: QUERY.id }).All()));
} else {
    writeRaw(JSON.stringify(await table.All()));
}
</rhp>

<rhp method="POST">
const table = DB.Table("widgets");
writeRaw(JSON.stringify(await table.Insert(BODY).Run()));
</rhp>

<rhp method="PUT">
const table = DB.Table("widgets");
writeRaw(JSON.stringify(await table.Where({ id: QUERY.id }).Update(BODY).Run()));
</rhp>

<rhp method="DELETE">
const table = DB.Table("widgets");
writeRaw(JSON.stringify(await table.Where({ id: QUERY.id }).Delete().Run()));
</rhp>
